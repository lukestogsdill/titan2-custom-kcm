<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A short tick when the Super key engages. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Edits the keyboard layout: what every key types on every layer. -->
        <activity
            android:name=".LayoutActivity"
            android:exported="false"
            android:label="Keyboard layout" />

        <!-- Edits the controller layer's keys (Sym+C). -->
        <activity
            android:name=".ControllerActivity"
            android:exported="false"
            android:label="Controller keybinds" />

        <!-- The on-screen keyboard: invisible until Sym+B opens the emoji panel. -->
        <service
            android:name=".EmojiKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Your layout, Shift/Alt/Sym locks, hold Home = Super, Sym+C controller, the lock badge. -->
        <service
            android:name=".SuperKeyService"
            android:exported="true"
            android:label="@string/super_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/super_key_service" />
        </service>

        <!-- Offers titan2-custom.kcm under Settings → Physical keyboard (same trick as ExKeyMo). -->
        <receiver
            android:name=".KeyboardLayoutReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.hardware.input.action.QUERY_KEYBOARD_LAYOUTS" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.input.metadata.KEYBOARD_LAYOUTS"
                android:resource="@xml/keyboard_layouts" />
        </receiver>
    </application>
</manifest>
