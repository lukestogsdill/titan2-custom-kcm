type OVERLAY

key Q {
    label:                              'Q'
    base:                               'q'
    shift, capslock:                    'Q'
    alt:                                '0'
    sym:                                '\u001b'
}

key W {
    label:                              'W'
    base:                               'w'
    shift, capslock:                    'W'
    alt:                                '1'
    sym:                                '~'
}

key E {
    label:                              'E'
    base:                               'e'
    shift, capslock:                    'E'
    alt:                                '2'
    sym:                                '$'
}

key R {
    label:                              'R'
    base:                               'r'
    shift, capslock:                    'R'
    alt:                                '3'
    sym:                                '&'
}

key T {
    label:                              'T'
    base:                               't'
    shift, capslock:                    'T'
    alt:                                '('
    sym:                                '{'
}

key Y {
    label:                              'Y'
    base:                               'y'
    shift, capslock:                    'Y'
    alt:                                ')'
    sym:                                '}'
}

key U {
    label:                              'U'
    base:                               'u'
    shift, capslock:                    'U'
    alt:                                '-'
    sym:                                '['
}

key I {
    label:                              'I'
    base:                               'i'
    shift, capslock:                    'I'
    alt:                                '_'
    sym:                                ']'
}

key O {
    label:                              'O'
    base:                               'o'
    shift, capslock:                    'O'
    alt:                                '/'
    sym:                                '\\'
}

key P {
    label:                              'P'
    base:                               'p'
    shift, capslock:                    'P'
    alt:                                ':'
    sym:                                ';'
}

key A {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    alt:                                '@'
    sym:                                replace TAB
}

key S {
    label:                              'S'
    base:                               's'
    shift, capslock:                    'S'
    alt:                                '4'
    sym:                                '%'
}

key D {
    label:                              'D'
    base:                               'd'
    shift, capslock:                    'D'
    alt:                                '5'
    sym:                                '^'
}

key F {
    label:                              'F'
    base:                               'f'
    shift, capslock:                    'F'
    alt:                                '6'
    sym:                                '<'
}

key G {
    label:                              'G'
    base:                               'g'
    shift, capslock:                    'G'
    alt:                                '*'
    sym:                                '>'
}

key H {
    label: 'H'
    base: 'h'
    shift, capslock: 'H'
    alt: '#'
    # Explicitly allow shift to combine with sym for selection
    sym: replace DPAD_LEFT
    sym+shift: replace DPAD_LEFT
}

key J {
    label: 'J'
    base: 'j'
    shift, capslock: 'J'
    alt: '+'
    sym: replace DPAD_DOWN
    sym+shift: replace DPAD_DOWN
}

key K {
    label: 'K'
    base: 'k'
    shift, capslock: 'K'
    alt: '"'
    sym: replace DPAD_UP
    sym+shift: replace DPAD_UP
}

key L {
    label: 'L'
    base: 'l'
    shift, capslock: 'L'
    alt: '\''
    sym: replace DPAD_RIGHT
    sym+shift: replace DPAD_RIGHT
}

key Z {
    label:                              'Z'
    base:                               'z'
    shift, capslock:                    'Z'
    alt:                                '!'
    sym:                                '='
}

key X {
    label:                              'X'
    base:                               'x'
    shift, capslock:                    'X'
    alt:                                '7'
}

key C {
    label:                              'C'
    base:                               'c'
    shift, capslock:                    'C'
    alt:                                '8'
}

key V {
    label:                              'V'
    base:                               'v'
    shift, capslock:                    'V'
    alt:                                '9'
}

key B {
    label:                              'B'
    base:                               'b'
    shift, capslock:                    'B'
    alt:                                '.'
}

key N {
    label:                              'N'
    base:                               'n'
    shift, capslock:                    'N'
    alt:                                ','
    sym:                                replace MOVE_HOME
}

key M {
    label:                              'M'
    base:                               'm'
    shift, capslock:                    'M'
    alt:                                '?'
    sym:                                replace MOVE_END
}

key SPACE {
    label:                              ' '
    base:                               ' '
    alt:                                ' '
    sym:                                replace SEARCH
}

key ENTER {
    label:                              '\n'
    base:                               '\n'
    alt:                                '\n'
    sym:                                replace INSERT
}
